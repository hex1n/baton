{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/hex1n/IdeaProjects/baton/spec/bootstrap/hooks/run-hook.sh\" post-artifact baton-validate-artifact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/hex1n/IdeaProjects/baton/spec/bootstrap/hooks/run-hook.sh\" pre-transition baton-validate-transition"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/hex1n/IdeaProjects/baton/spec/bootstrap/hooks/run-hook.sh\" stop-check baton-validate-state baton-validate-isolation",
            "statusMessage": "Checking harness state",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/hex1n/IdeaProjects/baton/spec/bootstrap/hooks/run-hook.sh\" session-start baton-harness-context",
            "statusMessage": "Loading harness context"
          }
        ]
      }
    ]
  }
}
