#!/usr/bin/env bash
# baton — CLI entry point for baton plan-first workflow
# Version: 3.0 (v5 flat install)
set -eu

BATON_HOME="${BATON_HOME:-$HOME/.baton}"
SETUP="$BATON_HOME/setup.sh"
CLAUDE_DIR="$HOME/.claude"

# --- Doctor (v5: checks user-level artifacts) ---

doctor() {
    _issues=0

    echo "Checking baton v5 installation..."
    echo ""

    # Source installation
    echo "  Source:"
    if [ -d "$BATON_HOME/.git" ]; then
        _ver="$(sed -n 's/^# Version: *//p' "$BATON_HOME/hooks/write-lock.sh" 2>/dev/null || echo "?")"
        printf "  ✓ ~/.baton is git repo (hook version: %s)\n" "$_ver"
    elif [ -d "$BATON_HOME" ]; then
        printf "  ⚠ ~/.baton exists but not a git repo\n"
        _issues=$((_issues + 1))
    else
        printf "  ✗ ~/.baton not found\n"
        _issues=$((_issues + 1))
    fi

    # Dispatch system
    if [ -f "$BATON_HOME/hooks/dispatch.sh" ]; then
        printf "  ✓ dispatch.sh present\n"
    else
        printf "  ✗ dispatch.sh missing\n"
        _issues=$((_issues + 1))
    fi
    if [ -f "$BATON_HOME/hooks/manifest.conf" ]; then
        printf "  ✓ manifest.conf present\n"
    else
        printf "  ✗ manifest.conf missing\n"
        _issues=$((_issues + 1))
    fi
    echo ""

    # User-level skills (symlinks in ~/.claude/skills/)
    echo "  Skills (~/.claude/skills/):"
    _smissing=0
    _broken=0
    for _skill in baton-plan baton-implement baton-review baton-research baton-debug baton-subagent baton-evolve using-baton; do
        _spath="$CLAUDE_DIR/skills/$_skill"
        if [ -L "$_spath" ]; then
            if [ -f "$_spath/SKILL.md" ]; then
                : # ok
            else
                printf "  ⚠ %s symlink broken\n" "$_skill"
                _broken=$((_broken + 1))
            fi
        elif [ -d "$_spath" ]; then
            printf "  ⚠ %s is directory (not symlink, run setup.sh)\n" "$_skill"
            _broken=$((_broken + 1))
        else
            _smissing=$((_smissing + 1))
        fi
    done
    if [ "$_smissing" -eq 0 ] && [ "$_broken" -eq 0 ]; then
        printf "  ✓ 8/8 skills symlinked\n"
    else
        [ "$_smissing" -gt 0 ] && { printf "  ✗ %s/8 missing\n" "$_smissing"; _issues=$((_issues + 1)); }
        [ "$_broken" -gt 0 ] && { printf "  ⚠ %s/8 broken\n" "$_broken"; _issues=$((_issues + 1)); }
    fi
    echo ""

    # User-level hooks (in ~/.claude/settings.json)
    echo "  Hooks (~/.claude/settings.json):"
    if [ -f "$CLAUDE_DIR/settings.json" ] && grep -q 'run-hook\.cmd' "$CLAUDE_DIR/settings.json" 2>/dev/null; then
        printf "  ✓ baton hooks configured\n"
    elif [ -f "$CLAUDE_DIR/settings.json" ]; then
        printf "  ⚠ settings.json exists but no baton hooks\n"
        _issues=$((_issues + 1))
    else
        printf "  ✗ settings.json not found\n"
        _issues=$((_issues + 1))
    fi
    echo ""

    # Constitution (in ~/.claude/CLAUDE.md)
    echo "  Constitution (~/.claude/CLAUDE.md):"
    if [ -f "$CLAUDE_DIR/CLAUDE.md" ] && grep -q 'constitution\.md' "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null; then
        printf "  ✓ constitution referenced\n"
    elif [ -f "$CLAUDE_DIR/CLAUDE.md" ]; then
        printf "  ⚠ CLAUDE.md exists but no constitution reference\n"
        _issues=$((_issues + 1))
    else
        printf "  ✗ CLAUDE.md not found\n"
        _issues=$((_issues + 1))
    fi
    echo ""

    if [ "$_issues" -gt 0 ]; then
        echo "  Result: $_issues issue(s) found. Run 'bash ~/.baton/setup.sh' to fix."
    else
        echo "  Result: all checks passed."
    fi
}

# --- Status ---

status() {
    _dir="${1:-.}"
    _dir="$(cd "$_dir" && pwd)"

    # Source parser from BATON_HOME (v5 layout)
    _parser=""
    [ -f "$BATON_HOME/hooks/lib/plan-parser.sh" ] && _parser="$BATON_HOME/hooks/lib/plan-parser.sh"
    if [ -z "$_parser" ]; then
        echo "⚠️ Parser not found in BATON_HOME" >&2
        return 1
    fi
    _BATON_PARSER_LOADED=""
    . "$_parser"

    JSON_CWD="$_dir"
    parser_find_plan
    parser_find_research

    _phase="RESEARCH"
    _plan_status="not found"
    _research_status="not found"
    _todos="0/0"

    if [ -n "$RESEARCH" ]; then
        _research_status="exists"
    elif [ "${RESEARCH_FALLBACK_COUNT:-0}" -gt 1 ] 2>/dev/null; then
        _research_status="multiple matches"
        RESEARCH_NAME="research-*.md"
    fi

    if [ -z "$PLAN" ] && { [ -n "$RESEARCH" ] || [ "${RESEARCH_FALLBACK_COUNT:-0}" -gt 1 ] 2>/dev/null; }; then
        _phase="PLAN"
    fi

    if [ -n "$PLAN" ]; then
        _plan_status="exists, no BATON:GO"
        _phase="ANNOTATION"

        if parser_has_go; then
            _plan_status="approved (BATON:GO)"
            _phase="IMPLEMENT"

            parser_todo_counts
            _todos="$TODO_DONE/$TODO_TOTAL"

            if [ "$TODO_TOTAL" -gt 0 ] && [ "$TODO_REMAINING" -eq 0 ]; then
                _phase="FINISH"
                if parser_retro_valid; then
                    _finish_status="ready to complete"
                else
                    _finish_status="retrospective needed"
                fi
            fi

            parser_todo_range
            if [ "${TODO_START:-0}" -eq 0 ] 2>/dev/null || [ "$TODO_TOTAL" -eq 0 ] 2>/dev/null; then
                _phase="AWAITING_TODO"
            fi
        fi
    fi

    echo "📍 Phase: $_phase"
    echo "   Plan:     $PLAN_NAME ($_plan_status)"
    echo "   Research: $RESEARCH_NAME ($_research_status)"
    echo "   Todos:    $_todos"
    if [ "$_phase" = "FINISH" ]; then
        echo "   Finish:   $_finish_status"
    fi
}

# --- Usage ---

usage() {
    cat << 'EOF'
baton — plan-first workflow for AI coding assistants (v5)

Usage:
  baton doctor             Check installation health (user-level)
  baton status [dir]       Show workflow phase and progress
  baton update             Update baton source (git pull + re-run setup)
  baton migrate [dir]      Migrate a v4 project to v5 (remove project-local artifacts)
  baton uninstall          Remove baton from user-level config
  baton help               Show this help

Environment:
  BATON_HOME               Override baton home directory (~/.baton)
  BATON_PLAN               Override plan filename
  BATON_BYPASS=1           Skip write-lock check
EOF
}

# --- Main ---

case "${1:-help}" in
    doctor)
        doctor
        ;;
    status)
        status "${2:-.}"
        ;;
    update)
        echo "Updating baton..."
        if git -C "$BATON_HOME" pull --ff-only; then
            echo "✓ Updated to latest"
        else
            echo "⚠ Update failed. Check for local changes in $BATON_HOME"
            exit 1
        fi
        bash "$SETUP"
        ;;
    migrate)
        bash "$SETUP" --migrate "${2:-.}"
        ;;
    init)
        # v4 compat: redirect to setup
        echo "Note: 'baton init' is no longer needed. Baton v5 installs user-level."
        echo "Running setup.sh..."
        bash "$SETUP"
        ;;
    uninstall)
        bash "$SETUP" --uninstall
        ;;
    self-update)
        echo "Note: 'baton self-update' is now just 'baton update'"
        exec "$0" update
        ;;
    help|--help|-h|*)
        usage
        ;;
esac
